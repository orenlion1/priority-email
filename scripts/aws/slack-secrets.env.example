# Slack app credentials for the priority-email events handler.
#
# These belong to priority-email's OWN Slack app (a SEPARATE app from re-rank),
# so they cannot be reused from re-rank's secrets — get them from that app's
# dashboard at https://api.slack.com/apps:
#
#   SLACK_SIGNING_SECRET  Basic Information -> App Credentials -> Signing Secret
#                         (32 lowercase hex characters)
#   SLACK_BOT_TOKEN       OAuth & Permissions -> Bot User OAuth Token
#                         (starts with "xoxb-"; needs channels:history + chat:write)
#
# Usage:
#   cp slack-secrets.env.example slack-secrets.env
#   # paste the two real values into slack-secrets.env
#   ./upload-slack-secrets.sh
#   # then shred it: rm -P slack-secrets.env   (macOS)   /   shred -u  (Linux)
#
# slack-secrets.env is gitignored. Never commit real values.

SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
